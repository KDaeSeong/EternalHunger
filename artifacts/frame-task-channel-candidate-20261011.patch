+      this.port1 = { onmessage: null, close: () => close(this.port1) };
+      this.port2 = { close: () => close(this.port2), postMessage: value => {
+        assert.equal(value, null, 'Only a scheduling signal, never match data.');
+        messages.set(id, () => this.port1.onmessage?.());
