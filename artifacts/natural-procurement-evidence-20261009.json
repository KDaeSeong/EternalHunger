  "definitions": {
    "explicitSharedRecipeIntent": "team_rotate plus an exact initial 팀 제작 구매: or 팀 제작 교환: reason; a presentation intention, not proof of execution.",
    "broadProcurementRotation": "team_rotate plus any 키오스크|구매|교환|kiosk text; preserved separately, not an exact shared recipe intention.",
    "receivedKioskSettlement": "completed kioskBuy/kioskExchange with actual string actor/action/item identity and positive integer received quantity; excludes kioskSell/cancelled receipts.",
    "queueJoin": "preceding journal queue with the same actor, action key, buy/exchange type and item ID; no backwards temporal join.",
    "paidCraftAssociation": "one-time quantity-bounded journal allocation from received catalogue materials to valid consuming craft events with positive craft cost and actual nonnegative credit delta.",
    "zeroFeeCraftAssociation": "same consumption, event identity and credit checks, but authored craft cost is zero and before/after credits agree; not free equipment correction.",
    "equipmentObservation": "same catalogue output ID occupies a real equipped slot and has positive inventory quantity in the craft publication frame; not physical item-lot provenance.",
    "sharedPurposeTagged": "an exact joined queue carries the shared recipe prefix; a label, not proof that the real transaction matches the named intended recipient/material."
  },
