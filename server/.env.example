NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/eternal_hunger
MY_SECRET_KEY=replace-with-at-least-32-random-characters

# Credentialed CORS allowlist. Comma-separate exact origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JSON_BODY_LIMIT=2mb
TRUST_PROXY_HOPS=0
# Render puts one proxy in front of Express: use TRUST_PROXY_HOPS=1 there.
# Same value as the Vercel env PROXY_SHARED_SECRET (16+ random chars). The Next
# proxy then forwards each browser's address, so login/sign-up limits are per
# visitor instead of shared by everyone behind the proxy.
PROXY_SHARED_SECRET=
MONGO_CONNECT_TIMEOUT_MS=10000

AUTH_TOKEN_TTL=30d
AUTH_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=10
SIGNUP_RATE_LIMIT_MAX=5
# Used only when the visitor address is unknown (proxy without PROXY_SHARED_SECRET).
SIGNUP_SHARED_RATE_LIMIT_MAX=30
RESET_PASSWORD_MAX_ATTEMPTS=8
COOKIE_SECURE=false

ANALYZE_RATE_LIMIT_WINDOW_MS=600000
ANALYZE_RATE_LIMIT_MAX=12
ANALYZE_MAX_TEXT_LENGTH=3000
GOOGLE_API_KEY=
# gemini-2.0-flash was shut down on 2026-06-01. Leave empty for the server default.
GOOGLE_AI_MODEL=gemini-3.6-flash

# Eternal Hunger results: client-reported, so saves per account are capped.
GAME_END_RATE_LIMIT_WINDOW_MS=3600000
GAME_END_RATE_LIMIT_MAX=30

GAME_ROOM_STATE_MAX_BYTES=262144
GAME_ROOM_RECORD_MAX_BYTES=524288
GAME_RECORD_MAX_BYTES=524288
GAME_SAVE_MAX_BYTES=524288
GAME_SAVE_MAX_SLOTS_PER_GAME=20

# Optional Eternal Return import settings
ER_API_BASE=
ER_API_KEY=
ER_META_AUTO=false
