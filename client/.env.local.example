# Local browser-to-Express development.
NEXT_PUBLIC_API_BASE=http://localhost:5000

# Required for the same-origin Next /api/proxy route in deployment.
# Use the exact trusted Express origin, without a trailing /api suffix.
BACKEND_BASE_URL=http://localhost:5000

# Independent allowlist for forwarding session credentials. Exact origins only.
AUTH_PROXY_CREDENTIAL_ORIGINS=http://localhost:5000

# Optional rendered-music delivery. These public values are embedded at build time.
# Leave the base empty for /audio/<game>/<track>.wav in the current checkout.
# For a verified CDN, use its HTTPS base (before /audio) and set format to mp3.
NEXT_PUBLIC_GAME_BGM_AUDIO_BASE_URL=
NEXT_PUBLIC_GAME_BGM_AUDIO_FORMAT=wav

# Optional absolute directory containing the preserved <game>/<track>.wav originals.
# Local audio quality checks still require the original WAVs after CDN migration.
# EH_RENDERED_AUDIO_ROOT=C:/audio-originals
